module Demo.Forms;

procedure Wait {blocking};
end Wait;

procedure Pick*(a, b: Integer; p, q: Boolean): Integer;
  var x, y: Integer;
  var z: LongInt;
begin
  x := a + b * 2 - (-a) div 3 mod 4;
  p := ~p & q or (a = b) & (a + 1 # b);
  if a < b then return a
  elsif a > b then x := 1;; y := 2
  elsif a <= b then
  else return b
  end;
  while (x >= 0) & ~q do x := x - 1 end;
  Wait;
  Wait();
  return x
end Pick;

end Demo.Forms.
